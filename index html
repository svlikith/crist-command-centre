                    document.getElementById('overview-pending-count').innerText = `${remaining} Pending`;
                }, 300);
            }
        }

        // --- 4. AI Chat Engine Integration ---
        const WORKER_URL = 'https://crist-ai-v2.svlikith56.workers.dev';

        async function sendMessage() {
            const inputEl = document.getElementById('chat-input');
            const message = inputEl.value.trim();
            if (!message) return;

            // Clear Input Area
            inputEl.value = '';

            // Render User Message
            renderChatMessage('USER', message);

            // Render AI Loading Skeleton Indicator
            const loadingId = 'msg-' + Date.now();
            renderChatMessage('AI', '<em>Analyzing directive through CRIST intelligence core...</em>', loadingId);

            try {
                // Query Cloudflare Worker API Backend Endpoint
                const response = await fetch(WORKER_URL, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });

                if (!response.ok) {
                    throw new Error(`Worker endpoint returned HTTP ${response.status}`);
                }

                const data = await response.json();
                const aiReply = data.reply || data.response || "Directive parsed successfully. No secondary payload returned.";
                
                // Replace Loading Message with Real AI Response
                updateChatMessage(loadingId, aiReply);

            } catch (err) {
                console.warn('Backend proxy offline or unreachable. Executing beast mode strategic fallback:', err);
                
                // Smart Co-Founder Fallback Handler
                const fallbackReply = generateStrategicFallback(message);
                updateChatMessage(loadingId, fallbackReply);
            }
        }

        function handleKeyPress(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        }

        function renderChatMessage(sender, text, id = null) {
            const messagesContainer = document.getElementById('chat-messages');
            const row = document.createElement('div');
            row.className = `message-row ${sender.toLowerCase()}`;
            if (id) row.id = id;

            const isAI = sender === 'AI';

            row.innerHTML = `
                <div class="avatar ${isAI ? 'ai' : 'user'}">${isAI ? 'AI' : 'YOU'}</div>
                <div class="message-bubble">
                    <div class="message-header">
                        <span>${isAI ? 'CRIST CO-FOUNDER' : 'EXECUTIVE COMMAND'}</span>
                        <span>${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
                    </div>
                    <div>${text}</div>
                </div>
            `;

            messagesContainer.appendChild(row);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function updateChatMessage(id, newText) {
            const row = document.getElementById(id);
            if (row) {
                const bubble = row.querySelector('.message-bubble div:nth-child(2)');
                if (bubble) {
                    bubble.innerHTML = newText;
                }
            }
        }

        // Strategic Local Co-Founder Response Generator (Fallback Engine)
        function generateStrategicFallback(userPrompt) {
            const query = userPrompt.toLowerCase();

            if (query.includes('gt-01') || query.includes('car') || query.includes('vehicle')) {
                return "<strong>GT-01 Strategic Directive:</strong> The GT-01 concept must prioritize modular structural weight reduction over premature powertrain commitments. I recommend finalizing digital CFD testing prior to hardware procurement.";
            } else if (query.includes('funding') || query.includes('investor') || query.includes('money')) {
                return "<strong>Capital Allocation Model:</strong> We are currently in Concept Stage. Focus capital strictly on virtual simulation, CAD validation, and securing key IP filings before approaching Tier-1 venture funds.";
            } else if (query.includes('chip') || query.includes('tech')) {
                return "<strong>CRIST Chip Research Notice:</strong> Hardware prototyping requires substantial semiconductor foundry allocation. We should remain focused on software-defined vehicle emulation architectures first.";
            } else {
                return `<strong>Executive Analysis:</strong> I have logged your instruction: <em>"${userPrompt}"</em>. As Co-Founder, I recommend evaluating this against our Phase 1 digital validation roadmap before deploying external resources.`;
            }
        }

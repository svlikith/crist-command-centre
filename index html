    <script>
        // --- 1. Ambient VFX Starfield / Grid Particle Canvas ---
        const canvas = document.getElementById('vfx-canvas');
        const ctx = canvas.getContext('2d');
        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        class Particle {
            constructor() {
                this.reset();
            }
            reset() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.vx = (Math.random() - 0.5) * 0.3;
                this.vy = (Math.random() - 0.5) * 0.3;
                this.size = Math.random() * 1.5 + 0.5;
                this.alpha = Math.random() * 0.5 + 0.1;
            }
            update() {
                this.x += this.vx;
                this.y += this.vy;
                if (this.x < 0 || this.x > width || this.y < 0 || this.y > height) {
                    this.reset();
                }
            }
            draw() {
                ctx.fillStyle = `rgba(0, 162, 255, ${this.alpha})`;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }
        }

        const particles = Array.from({ length: 65 }, () => new Particle());

        function animateVFX() {
            ctx.clearRect(0, 0, width, height);
            
            // Draw subtle background grid
            ctx.strokeStyle = 'rgba(180, 195, 210, 0.03)';
            ctx.lineWidth = 1;
            const gridSize = 60;
            for (let x = 0; x < width; x += gridSize) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, height);
                ctx.stroke();
            }
            for (let y = 0; y < height; y += gridSize) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(width, y);
                ctx.stroke();
            }

            // Update & Render Particles
            particles.forEach(p => {
                p.update();
                p.draw();
            });

            requestAnimationFrame(animateVFX);
        }
        animateVFX();

        // --- 2. Application Navigation & State Routing ---
        function switchModule(moduleId) {
            // Update Active Nav Items
            document.querySelectorAll('.nav-item').forEach(item => {
                item.classList.remove('active');
            });
            event.currentTarget.classList.add('active');

            // Hide all Views & Display Active
            document.querySelectorAll('.module-view').forEach(view => {
                view.classList.remove('active');
            });

            const targetView = document.getElementById(`view-${moduleId}`);
            if (targetView) {
                targetView.classList.add('active');
            }

            // Update Header Title Text
            const titleMap = {
                'overview': 'Executive Overview',
                'ai-chat': 'AI Co-Founder Chat Engine',
                'strategy': 'Strategy & Roadmap Phase Gates',
                'approvals': 'Approval Centre Governance',
                'gt01': 'CRIST GT-01 Programme',
                'tech-lab': 'CRIST Chip Technology Lab',
                'finance': 'Financial Scenario Simulator',
                'security': 'System Security & Access Controls'
            };

            document.getElementById('module-title').innerHTML = `${titleMap[moduleId] || 'Command Centre'} <span class="badge-mode">v2.0 PRO</span>`;

            // Auto Close Mobile Navigation Drawer
            document.getElementById('sidebar').classList.remove('mobile-open');
        }

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('mobile-open');
        }

        // --- 3. Approval System Execution Logic ---
        function resolveApproval(elementId, approved) {
            const card = document.getElementById(elementId);
            if (card) {
                card.style.transition = 'all 0.3s ease';
                card.style.opacity = '0';
                card.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    card.remove();

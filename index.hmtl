<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>CRIST AI — Founder Command Centre</title>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#05060A">
<style>
:root{--bg:#05060A;--card:rgba(14,18,28,.72);--line:rgba(0,229,255,.18);--blue:#00E5FF;--purple:#A855F7;
--ti:#94A3B8;--tx:#F8FAFC;--mu:#64748B;--ok:#10B981;--warn:#F59E0B;--bad:#EF4444}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{background:var(--bg)}
body{color:var(--tx);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;min-height:100vh;
padding-top:env(safe-area-inset-top);padding-bottom:calc(env(safe-area-inset-bottom) + 84px)}
#bg{position:fixed;inset:0;z-index:-1;width:100%;height:100%}
/* boot */
#boot{position:fixed;inset:0;z-index:999;background:#05060A;display:flex;flex-direction:column;align-items:center;
justify-content:center;gap:18px;transition:opacity .6s,visibility .6s}
#boot.off{opacity:0;visibility:hidden}
.boot-logo{font-size:2rem;font-weight:900;letter-spacing:.35em;background:linear-gradient(90deg,#fff,var(--blue),var(--purple));
-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:pulse 1.4s infinite}
.boot-bar{width:200px;height:3px;background:rgba(255,255,255,.08);border-radius:3px;overflow:hidden}
.boot-bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--blue),var(--purple));animation:load 1.6s forwards}
.boot-txt{font:.7rem ui-monospace,Menlo,monospace;color:var(--ti);letter-spacing:.1em}
@keyframes load{to{width:100%}}
@keyframes pulse{50%{opacity:.55}}
/* header */
header{position:sticky;top:0;z-index:50;display:flex;justify-content:space-between;align-items:center;padding:14px 18px;
background:rgba(5,6,10,.65);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);border-bottom:1px solid rgba(255,255,255,.07)}
.brand{font-weight:900;letter-spacing:.18em;font-size:1.05rem;background:linear-gradient(90deg,#fff,var(--blue));
-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.sub{font-size:.6rem;color:var(--mu);letter-spacing:.08em}
.right{display:flex;flex-direction:column;align-items:flex-end;gap:5px}
.stage{font-size:.6rem;font-weight:800;letter-spacing:.08em;padding:3px 8px;border-radius:999px;color:var(--warn);
background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.4);text-transform:uppercase}
.status{font-size:.62rem;color:var(--ti);display:flex;align-items:center;gap:6px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--mu)}
.dot.on{background:var(--ok);box-shadow:0 0 10px var(--ok);animation:pulse 1.6s infinite}
.dot.off{background:var(--bad);box-shadow:0 0 10px var(--bad)}
main{padding:16px}
.view{display:none}.view.active{display:block;animation:in .35s ease}
@keyframes in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
/* hero */
.hero{text-align:center;padding:26px 16px 18px;margin-bottom:14px}
.orb{width:120px;height:120px;margin:0 auto 16px;border-radius:50%;position:relative;
background:radial-gradient(circle at 35% 30%,#fff 0,var(--blue) 18%,var(--purple) 55%,#12062a 100%);
box-shadow:0 0 40px rgba(0,229,255,.55),0 0 90px rgba(168,85,247,.4),inset 0 0 30px rgba(255,255,255,.25);animation:float 4s ease-in-out infinite}
.orb:before,.orb:after{content:"";position:absolute;inset:-14px;border-radius:50%;border:1px solid rgba(0,229,255,.35);animation:ring 3s linear infinite}
.orb:after{inset:-28px;border-color:rgba(168,85,247,.3);animation-duration:5s;animation-direction:reverse}
@keyframes float{50%{transform:translateY(-8px)}}
@keyframes ring{from{transform:rotate(0) scale(1)}50%{transform:rotate(180deg) scale(1.06)}to{transform:rotate(360deg) scale(1)}}
.hero h1{font-size:1.5rem;font-weight:900;letter-spacing:.04em}
.hero p{font-size:.8rem;color:var(--ti);margin-top:6px;line-height:1.5}
.card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:16px;margin-bottom:14px;
backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);box-shadow:0 8px 30px rgba(0,0,0,.45);position:relative;overflow:hidden}
.card:before{content:"";position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--blue),transparent);opacity:.5}
.purple{border-color:rgba(168,85,247,.35)}
.ct{font-size:.78rem;color:var(--ti);text-transform:uppercase;letter-spacing:.1em;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.m{background:rgba(25,32,48,.6);border:1px solid rgba(255,255,255,.07);border-radius:14px;padding:13px}
.m small{font-size:.6rem;color:var(--ti);letter-spacing:.08em}
.m b{display:block;font-size:1.5rem;margin-top:4px;background:linear-gradient(90deg,#fff,var(--blue));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.tag{display:inline-block;font-size:.58rem;font-weight:800;letter-spacing:.05em;padding:2px 7px;border-radius:5px;text-transform:uppercase;white-space:nowrap}
.t-f{background:rgba(16,185,129,.15);color:var(--ok)}.t-a{background:rgba(245,158,11,.15);color:var(--warn)}
.t-e{background:rgba(0,229,255,.15);color:var(--blue)}.t-r{background:rgba(168,85,247,.15);color:var(--purple)}
.row{padding:12px;background:rgba(10,13,20,.6);border:1px solid rgba(255,255,255,.07);border-radius:12px;margin-bottom:8px}
.rh{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:4px;font-size:.88rem}
.rd{font-size:.78rem;color:var(--ti);line-height:1.45}
.banner{border-left:3px solid var(--blue);background:rgba(0,229,255,.05);padding:10px 12px;border-radius:8px;font-size:.72rem;color:var(--ti);line-height:1.45;margin-bottom:14px}
/* timeline */
.tl{position:relative;padding-left:22px}
.tl:before{content:"";position:absolute;left:6px;top:4px;bottom:4px;width:2px;background:linear-gradient(var(--blue),var(--purple),transparent)}
.st{position:relative;margin-bottom:14px;font-size:.82rem}
.st:before{content:"";position:absolute;left:-21px;top:3px;width:10px;height:10px;border-radius:50%;background:var(--bg);border:2px solid var(--mu)}
.st.now:before{border-color:var(--blue);background:var(--blue);box-shadow:0 0 12px var(--blue)}
.st small{display:block;color:var(--mu);font-size:.68rem;margin-top:2px}
/* inputs */
input,select{width:100%;background:#0b0f18;border:1px solid rgba(255,255,255,.12);border-radius:12px;padding:13px;color:var(--tx);font-size:16px;font-family:inherit;margin-bottom:10px;outline:none}
input:focus,select:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(0,229,255,.12)}
button{font-family:inherit;font-weight:700;border:none;outline:none;cursor:pointer;transition:transform .15s,opacity .2s}
button:active{transform:scale(.96)}
.btn{width:100%;padding:13px;border-radius:12px;font-size:.85rem;color:#04070d;background:linear-gradient(135deg,var(--blue),var(--purple));box-shadow:0 6px 24px rgba(0,229,255,.25)}
.btn:disabled{opacity:.5}
.btn2{padding:10px 14px;border-radius:10px;font-size:.78rem;color:var(--tx);background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.14)}
.ok{padding:8px 12px;border-radius:8px;font-size:.75rem;background:rgba(16,185,129,.15);border:1px solid var(--ok);color:var(--ok)}
.no{padding:8px 12px;border-radius:8px;font-size:.75rem;background:rgba(239,68,68,.15);border:1px solid var(--bad);color:var(--bad)}
.acts{display:flex;gap:8px;margin-top:10px}
/* chat */
.chat{display:flex;flex-direction:column;height:calc(100vh - 235px);min-height:380px}
.msgs{flex:1;overflow-y:auto;display:flex;flex-direction:column;gap:12px;padding:4px 0 12px}
.b{max-width:88%;padding:12px 14px;border-radius:16px;font-size:.88rem;line-height:1.5;word-wrap:break-word;user-select:text;-webkit-user-select:text}
.b.u{align-self:flex-end;background:linear-gradient(135deg,#0891b2,#7c3aed);border-bottom-right-radius:4px;white-space:pre-wrap}
.b.a{align-self:flex-start;background:rgba(18,24,36,.92);border:1px solid rgba(0,229,255,.22);border-bottom-left-radius:4px;color:#E2E8F0}
.b.a ul{margin:6px 0 6px 18px}.b.a p{margin:4px 0}
.cp{margin-top:8px;font-size:.62rem;color:var(--ti);background:rgba(255,255,255,.06);border-radius:6px;padding:3px 8px}
.typing span{display:inline-block;width:6px;height:6px;margin:0 2px;border-radius:50%;background:var(--blue);animation:bounce 1s infinite}
.typing span:nth-child(2){animation-delay:.15s}.typing span:nth-child(3){animation-delay:.3s}
@keyframes bounce{50%{transform:translateY(-5px);opacity:.4}}
.chips{display:flex;gap:8px;overflow-x:auto;padding:4px 0 10px;scrollbar-width:none}
.chip{flex-shrink:0;font-size:.72rem;padding:7px 13px;border-radius:20px;color:var(--blue);background:rgba(0,229,255,.07);border:1px solid rgba(0,229,255,.3)}
.bar{display:flex;gap:8px;align-items:center}
.bar input{margin:0}
.ib{flex-shrink:0;width:46px;height:46px;border-radius:12px;font-size:1.1rem;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);color:var(--tx)}
.ib.rec{background:rgba(239,68,68,.25);border-color:var(--bad);animation:pulse 1s infinite}
.send{flex-shrink:0;width:60px;height:46px;border-radius:12px;font-size:.8rem;color:#04070d;background:linear-gradient(135deg,var(--blue),var(--purple))}
/* nav */
nav{position:fixed;bottom:0;left:0;right:0;z-index:100;display:flex;justify-content:space-around;
padding:10px 6px calc(env(safe-area-inset-bottom) + 6px);background:rgba(5,6,10,.82);
backdrop-filter:blur(26px);-webkit-backdrop-filter:blur(26px);border-top:1px solid rgba(255,255,255,.08)}
.nb{flex:1;background:transparent;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:.6rem;color:var(--ti);font-weight:600}
.nb i{font-style:normal;font-size:1.2rem;filter:grayscale(1);opacity:.7}
.nb.active{color:var(--blue)}.nb.active i{filter:none;opacity:1;text-shadow:0 0 12px var(--blue)}
.empty{font-size:.8rem;color:var(--mu);padding:6px}
</style>
</head>
<body>
<canvas id="bg"></canvas>

<div id="boot">
  <div class="boot-logo">CRIST AI</div>
  <div class="boot-bar"><i></i></div>
  <div class="boot-txt" id="boot-txt">INITIALISING COMMAND CENTRE…</div>
</div>

<header>
  <div><div class="brand">CRIST AI</div><div class="sub">FOUNDER COMMAND CENTRE</div></div>
  <div class="right">
    <div class="stage">Phase 0 · Concept</div>
    <div class="status"><span class="dot" id="dot"></span><span id="stxt">Checking AI…</span></div>
  </div>
</header>

<main>

<!-- HOME -->
<section id="v-home" class="view active">
  <div class="card hero">
    <div class="orb"></div>
    <h1>CRIST Motors</h1>
    <p>An early-stage automotive and mobility technology startup concept.<br>Original vehicles · AI-assisted engineering · Honest roadmap.</p>
  </div>

  <div class="grid">
    <div class="m"><small>PHASE</small><b style="font-size:1.05rem">Concept</b></div>
    <div class="m"><small>OPEN TASKS</small><b id="m-t">0</b></div>
    <div class="m"><small>PENDING APPROVALS</small><b id="m-a">0</b></div>
    <div class="m"><small>AI CONVERSATIONS</small><b id="m-c">0</b></div>
  </div>

  <div class="banner"><strong>FOUNDER ACCURACY GUARDRAIL:</strong> Nothing here is a built product, funded programme or verified technology unless you mark it so. Every item is tagged Fact, Assumption, Estimate or Recommendation.</div>

  <div class="card">
    <div class="ct"><span>Roadmap</span><span class="tag t-r">Plan</span></div>
    <div class="tl">
      <div class="st now"><strong>Vision &amp; Brand</strong><small>NOW · define the story, name, identity</small></div>
      <div class="st"><strong>Market Validation</strong><small>Talk to buyers, enthusiasts, engineers</small></div>
      <div class="st"><strong>Research</strong><small>Powertrain, chassis, regulations</small></div>
      <div class="st"><strong>Team</strong><small>Co-founder, advisors, engineers</small></div>
      <div class="st"><strong>Specifications</strong><small>Targets, constraints, budget</small></div>
      <div class="st"><strong>CAD &amp; Simulation</strong><small>Digital design and analysis</small></div>
      <div class="st"><strong>Prototype</strong><small>Only after funding and validation</small></div>
    </div>
  </div>

  <div class="card purple">
    <div class="ct">Data Sovereignty</div>
    <p class="rd" style="margin-bottom:10px">Your tasks, approvals and chat history stay on this device. Export a backup any time.</p>
    <button class="btn2" onclick="exportData()">Export backup (JSON)</button>
  </div>
</section>

<!-- AI -->
<section id="v-chat" class="view">
  <div class="chat">
    <div class="chips">
      <div class="chip" onclick="quick('Summarize CRIST Motors honestly in 5 lines for a co-founder.')">Honest summary</div>
      <div class="chip" onclick="quick('List the 5 biggest risks for a concept-stage EV hypercar startup.')">Top risks</div>
      <div class="chip" onclick="quick('Give me a 90-day roadmap from concept to validated specification.')">90-day roadmap</div>
      <div class="chip" onclick="quick('Write a 30-second founder introduction for CRIST Motors.')">Founder intro</div>
      <div class="chip" onclick="quick('What should I build first: a car, a bike, or software? Explain.')">First product?</div>
    </div>
    <div class="msgs" id="msgs"></div>
    <div class="bar">
      <button class="ib" id="mic" onclick="voice()" title="Voice">🎤</button>
      <input id="inp" placeholder="Ask CRIST AI…" onkeydown="if(event.key==='Enter')send()">
      <button class="send" id="sendb" onclick="send()">Send</button>
    </div>
    <div style="text-align:center;margin-top:8px"><button class="btn2" style="font-size:.65rem;padding:5px 10px" onclick="clearChat()">Clear chat</button></div>
  </div>
</section>

<!-- TASKS -->
<section id="v-tasks" class="view">
  <div class="card">
    <div class="ct">Add Strategic Task</div>
    <input id="tt" placeholder="Task title">
    <div style="display:flex;gap:8px">
      <select id="tp"><option value="High">P1 Critical</option><option value="Medium">P2 Moderate</option><option value="Low">P3 Advisory</option></select>
      <input id="td" type="date">
    </div>
    <button class="btn" onclick="addTask()">Add Task</button>
  </div>
  <div class="card"><div class="ct">Active Tasks</div><div id="tl"></div></div>
</section>

<!-- GT-01 -->
<section id="v-gt" class="view">
  <div class="card">
    <div class="ct"><span>GT-01 Concept</span><span class="tag t-e">Hypothesis</span></div>
    <div class="row"><div class="rh"><strong>Target architecture</strong><span class="tag t-a">Assumption</span></div><div class="rd">Dual-motor electric layout. Unvalidated concept only.</div></div>
    <div class="row"><div class="rh"><strong>Chassis &amp; battery pack</strong><span class="tag t-r">Recommended</span></div><div class="rd">Review options with a qualified vehicle engineer.</div></div>
    <div class="row"><div class="rh"><strong>Thermal management</strong><span class="tag t-a">Assumption</span></div><div class="rd">Needs simulation before any claim is made.</div></div>
    <div class="row"><div class="rh"><strong>Aero targets</strong><span class="tag t-e">Estimate</span></div><div class="rd">Initial goals only. No CFD or wind-tunnel data yet.</div></div>
  </div>
  <div class="card purple">
    <div class="ct"><span>Company Ground Truth</span><span class="tag t-f">Fact</span></div>
    <div class="row"><div class="rh"><strong>Status</strong><span class="tag t-f">Fact</span></div><div class="rd">Early-stage concept. No prototype, factory or confirmed funding.</div></div>
  </div>
</section>

<!-- APPROVALS -->
<section id="v-appr" class="view">
  <div class="banner"><strong>CONFIRMATION PROTOCOL:</strong> No external action happens without your approval. Buttons here only record your decision.</div>
  <div class="card"><div class="ct">Pending Approvals</div><div id="al"></div></div>
  <div class="card"><div class="ct">Activity Log</div><div id="ll"></div></div>
</section>

</main>

<nav>
  <button class="nb active" onclick="tab('v-home',this)"><i>🏠</i>Home</button>
  <button class="nb" onclick="tab('v-chat',this)"><i>🤖</i>AI</button>
  <button class="nb" onclick="tab('v-tasks',this)"><i>✅</i>Tasks</button>
  <button class="nb" onclick="tab('v-gt',this)"><i>🏎️</i>GT-01</button>
  <button class="nb" onclick="tab('v-appr',this)"><i>🛡️</i>Approvals</button>
</nav>

<script>
const API="https://crist-ai-v2.svlikith56.workers.dev";
const KEY="crist_cc_v2";
let S={tasks:[
 {id:1,title:"Stress-test GT-01 concept assumptions",priority:"High",due:""},
 {id:2,title:"Structure Technical Advisory Framework",priority:"Medium",due:""},
 {id:3,title:"Prepare honest Pre-Seed summary",priority:"Medium",due:""}],
 approvals:[
 {id:1,title:"Release GT-01 concept brief",tag:"Assumption",cons:"Shares unvalidated targets externally."},
 {id:2,title:"Cold outreach to advisors",tag:"Draft",cons:"Contacts third parties on your behalf."}],
 logs:["System initialised in Concept-Only mode."],chat:[],convos:0};

const $=id=>document.getElementById(id);
function el(t,c,x){const n=document.createElement(t);if(c)n.className=c;if(x!==undefined)n.textContent=x;return n}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}metrics()}
function load(){try{const s=localStorage.getItem(KEY);if(s)S=Object.assign(S,JSON.parse(s))}catch(e){}}
function count(id,to){const n=$(id);let c=0;const step=Math.max(1,Math.ceil(to/20));
 const t=setInterval(()=>{c=Math.min(to,c+step);n.textContent=c;if(c>=to)clearInterval(t)},30)}
function metrics(){count("m-t",S.tasks.length);count("m-a",S.approvals.length);count("m-c",S.convos)}
function log(m){S.logs.unshift(new Date().toLocaleString()+" — "+m);S.logs=S.logs.slice(0,50);save();rLogs()}

/* tabs */
function tab(id,b){document.querySelectorAll(".view").forEach(v=>v.classList.remove("active"));
 document.querySelectorAll(".nb").forEach(x=>x.classList.remove("active"));
 $(id).classList.add("active");if(b)b.classList.add("active");window.scrollTo(0,0);
 if(id==="v-chat")setTimeout(()=>{$("msgs").scrollTop=1e9},50)}

/* tasks */
function rTasks(){const c=$("tl");c.textContent="";
 if(!S.tasks.length){c.appendChild(el("div","empty","No active tasks."));return}
 S.tasks.forEach(t=>{const r=el("div","row"),h=el("div","rh");h.appendChild(el("strong","",t.title));
  h.appendChild(el("span","tag "+(t.priority==="High"?"t-a":t.priority==="Low"?"t-f":"t-e"),t.priority));r.appendChild(h);
  if(t.due)r.appendChild(el("div","rd","Due: "+t.due));
  const a=el("div","acts"),d=el("button","ok","Done");
  d.onclick=()=>{S.tasks=S.tasks.filter(x=>x.id!==t.id);log("Completed: "+t.title);rTasks()};
  a.appendChild(d);r.appendChild(a);c.appendChild(r)})}
function addTask(){const v=$("tt").value.trim();if(!v)return;
 S.tasks.push({id:Date.now(),title:v,priority:$("tp").value,due:$("td").value});$("tt").value="";log("Added task: "+v);rTasks()}

/* approvals */
function rAppr(){const c=$("al");c.textContent="";
 if(!S.approvals.length){c.appendChild(el("div","empty","Nothing waiting."));return}
 S.approvals.forEach(a=>{const r=el("div","row"),h=el("div","rh");h.appendChild(el("strong","",a.title));
  h.appendChild(el("span","tag t-a",a.tag));r.appendChild(h);r.appendChild(el("div","rd","Consequence: "+a.cons));
  const g=el("div","acts"),y=el("button","ok","Approve"),n=el("button","no","Reject");
  y.onclick=()=>res(a,"Approved");n.onclick=()=>res(a,"Rejected");g.appendChild(y);g.appendChild(n);r.appendChild(g);c.appendChild(r)})}
function res(a,v){S.approvals=S.approvals.filter(x=>x.id!==a.id);log(v+": "+a.title+" (recorded only, no external action)");rAppr()}
function rLogs(){const c=$("ll");c.textContent="";S.logs.forEach(l=>c.appendChild(el("div","rd","• "+l)))}

/* export */
function exportData(){const b=new Blob([JSON.stringify(S,null,2)],{type:"application/json"});
 const a=document.createElement("a");a.href=URL.createObjectURL(b);a.download="crist-backup.json";a.click();URL.revokeObjectURL(a.href)}

/* safe markdown-lite */
function inline(p,text){text.split(/\*\*(.+?)\*\*/g).forEach((s,i)=>{if(!s)return;
 if(i%2){p.appendChild(el("strong","",s))}else p.appendChild(document.createTextNode(s.replace(/\*(?=\S)/g,"")))})}
function render(box,text){box.textContent="";let ul=null;
 text.split("\n").forEach(line=>{const m=line.match(/^\s*[*\-•]\s+(.*)/);
  if(m){if(!ul){ul=el("ul");box.appendChild(ul)}const li=el("li");inline(li,m[1]);ul.appendChild(li)}
  else{ul=null;if(line.trim()){const p=el("p");inline(p,line.replace(/^#+\s*/,""));box.appendChild(p)}}})}

/* chat */
function bubble(text,who,instant){const b=el("div","b "+(who==="u"?"u":"a"));
 if(who==="u")b.textContent=text;else if(instant)render(b,text);
 $("msgs").appendChild(b);$("msgs").scrollTop=1e9;return b}
function addCopy(b,text){const c=el("button","cp","Copy");
 c.onclick=()=>{try{navigator.clipboard.writeText(text);c.textContent="Copied ✓"}catch(e){c.textContent="Select text to copy"}};b.appendChild(c)}
function typeOut(b,text,done){let i=0;const step=Math.max(2,Math.ceil(text.length/220));
 const t=setInterval(()=>{i+=step;b.textContent=text.slice(0,i);$("msgs").scrollTop=1e9;
  if(i>=text.length){clearInterval(t);render(b,text);addCopy(b,text);$("msgs").scrollTop=1e9;done&&done()}},16)}
function restore(){const m=$("msgs");m.textContent="";
 if(!S.chat.length){bubble("**CRIST Co-Founder AI** online. I treat CRIST Motors as an early-stage concept and will never invent prototypes, funding or technology. How can I help?","a",true);return}
 S.chat.forEach(x=>{const b=bubble(x.t,x.w,true);if(x.w==="a")addCopy(b,x.t)})}
function clearChat(){S.chat=[];save();restore()}
function quick(t){$("inp").value=t;send()}
async function send(){const inp=$("inp"),btn=$("sendb"),msg=inp.value.trim();if(!msg)return;
 if(msg.length>2000){bubble("Please keep messages under 2000 characters.","a",true);return}
 inp.value="";bubble(msg,"u");S.chat.push({w:"u",t:msg});
 const b=el("div","b a");const ty=el("div","typing");ty.innerHTML="<span></span><span></span><span></span>";
 b.appendChild(ty);$("msgs").appendChild(b);$("msgs").scrollTop=1e9;btn.disabled=true;
 let reply;try{const r=await fetch(API,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({message:msg})});
  const d=await r.json();reply=d.reply||d.error||"No response."}catch(e){reply="Connection error. Check your internet and try again."}
 S.chat.push({w:"a",t:reply});S.chat=S.chat.slice(-40);S.convos++;save();
 typeOut(b,reply,()=>{btn.disabled=false})}

/* voice */
let rec=null;
function voice(){const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
 if(!SR){alert("Voice input isn't supported in this browser. Use the keyboard mic instead.");return}
 const m=$("mic");if(rec){rec.stop();return}
 rec=new SR();rec.lang="en-IN";rec.interimResults=false;m.classList.add("rec");
 rec.onresult=e=>{$("inp").value=e.results[0][0].transcript};
 rec.onend=()=>{m.classList.remove("rec");rec=null};rec.onerror=()=>{m.classList.remove("rec");rec=null};rec.start()}

/* worker status */
async function ping(){try{const r=await fetch(API);const d=await r.json();
 if(d.status==="online"){$("dot").className="dot on";$("stxt").textContent="AI online";return}throw 0}
 catch(e){$("dot").className="dot off";$("stxt").textContent="AI offline"}}

/* animated background */
(function(){const c=$("bg"),x=c.getContext("2d");let w,h,P=[];
 function size(){w=c.width=innerWidth;h=c.height=innerHeight;P=[];
  const n=Math.min(70,Math.floor(w*h/16000));
  for(let i=0;i<n;i++)P.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*.35,vy:(Math.random()-.5)*.35})}
 function frame(){x.clearRect(0,0,w,h);
  for(let i=0;i<P.length;i++){const p=P[i];p.x+=p.vx;p.y+=p.vy;
   if(p.x<0||p.x>w)p.vx*=-1;if(p.y<0||p.y>h)p.vy*=-1;
   x.beginPath();x.arc(p.x,p.y,1.6,0,6.283);x.fillStyle="rgba(0,229,255,.7)";x.fill();
   for(let j=i+1;j<P.length;j++){const q=P[j],dx=p.x-q.x,dy=p.y-q.y,d=Math.sqrt(dx*dx+dy*dy);
    if(d<110){x.beginPath();x.moveTo(p.x,p.y);x.lineTo(q.x,q.y);
     x.strokeStyle="rgba(168,85,247,"+(.28*(1-d/110))+")";x.lineWidth=1;x.stroke()}}}
  requestAnimationFrame(frame)}
 addEventListener("resize",size);size();frame()})();

/* boot */
load();rTasks();rAppr();rLogs();restore();metrics();ping();setInterval(ping,60000);
const lines=["LOADING FOUNDER GUARDRAILS…","CONNECTING SECURE AI WORKER…","CONCEPT-STAGE MODE ACTIVE"];
lines.forEach((l,i)=>setTimeout(()=>{$("boot-txt").textContent=l},i*500));
setTimeout(()=>$("boot").classList.add("off"),1800);
</script>
</body>
</html>
